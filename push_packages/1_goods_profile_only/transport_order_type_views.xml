<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_transport_order_type_list" model="ir.ui.view">
            <field name="name">transport.order.type.list</field>
            <field name="model">transport.order.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="code" optional="show" />
                    <field name="name" optional="show" />
                    <field name="company_ids" widget="many2many_tags" />
                </list>
            </field>
        </record>

        <record id="view_transport_order_type_form" model="ir.ui.view">
            <field name="name">transport.order.type.form</field>
            <field name="model">transport.order.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="code" />
                                <field name="name" />
                                <field name="default_pickup_duration" />
                                <field name="default_delivery_duration" />
                                <field name="bol_number_source" />
                                <field name="company_ids" widget="many2many_tags" />
                                <field name="auto_plan_assignments" />
                                <field name="goods_profile_id"
                                    options="{'no_create_edit': True}" />
                                <field name="requirement_ids" widget="many2many_tags"
                                    options="{'color_field': 'color', 'no_create_edit': True}" />
                            </group>
                            <group>
                                <group string="Pickup Requirement">
                                    <field name="require_pickup_signature" />
                                    <field name="require_pickup_photo" />
                                    <field name="require_pickup_assignment_scanning" />
                                    <field name="require_pickup_goods_scanning" />
                                </group>
                                <group string="Delivery Requirement">
                                    <field name="require_delivery_signature" />
                                    <field name="require_delivery_photo" />
                                    <field name="require_delivery_assignment_scanning" />
                                    <field name="require_delivery_goods_scanning" />
                                </group>
                                <group string="Work Time Reporting">
                                    <field name="require_work_time_reporting" widget="boolean_toggle" />
                                </group>
                                <group string="Material Reporting">
                                    <field name="require_material_reporting" widget="boolean_toggle" />
                                </group>
                            </group>
                        </group>
                        <group string="Validation Configuration">
                            <field name="mandatory_field_ids" widget="many2many_tags"
                                options="{'no_create': True}" />
                        </group>
                        <group>
                            <group string="Planning Criteria Configuration">
                                <field name="apc_billable_weight_interval" widget="boolean_toggle"/>
                                <field name="apc_volume_interval" widget="boolean_toggle"/>
                                <field name="apc_ldm_interval" widget="boolean_toggle"/>
                                <field name="apc_gross_weight_interval" widget="boolean_toggle"/>
                                <field name="apc_distance_interval" widget="boolean_toggle"/>
                                <field name="apc_sender_zip_prefix" widget="boolean_toggle"/>
                                <field name="apc_sender_country" widget="boolean_toggle"/>
                                <field name="apc_receiver_zip_prefix" widget="boolean_toggle"/>
                                <field name="apc_receiver_country" widget="boolean_toggle"/>
                                <field name="apc_customer" widget="boolean_toggle"/>
                                <field name="apc_company" string="Company" widget="boolean_toggle"/>
                                <field name="apc_sender_price_zone" widget="boolean_toggle"/>
                                <field name="apc_receiver_price_zone" widget="boolean_toggle"/>
                                <field name="apc_freight_service" widget="boolean_toggle"/>
                                <field name="apc_adr" widget="boolean_toggle"/>
                                <field name="apc_bulky_goods" widget="boolean_toggle"/>
                                <field name="apc_requirements" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group string="Assignment planning criteria">
                            <field name="assignment_planning_criteria_ids" nolabel="1">
                                <list editable="bottom" multi_edit="1">
                                    <field name="billable_weight_from" required="parent.apc_billable_weight_interval" column_invisible="parent.apc_billable_weight_interval == False" />
                                    <field name="billable_weight_to" required="parent.apc_billable_weight_interval" column_invisible="parent.apc_billable_weight_interval == False" />
                                    <field name="volume_from" required="parent.apc_volume_interval" column_invisible="parent.apc_volume_interval == False" />
                                    <field name="volume_to" required="parent.apc_volume_interval" column_invisible="parent.apc_volume_interval == False" />
                                    <field name="ldm_from" required="parent.apc_ldm_interval" column_invisible="parent.apc_ldm_interval == False" />
                                    <field name="ldm_to" required="parent.apc_ldm_interval" column_invisible="parent.apc_ldm_interval == False" />
                                    <field name="gross_weight_from" required="parent.apc_gross_weight_interval" column_invisible="parent.apc_gross_weight_interval == False" />
                                    <field name="gross_weight_to" required="parent.apc_gross_weight_interval" column_invisible="parent.apc_gross_weight_interval == False" />
                                    <field name="distance_from" required="parent.apc_distance_interval" column_invisible="parent.apc_distance_interval == False" />
                                    <field name="distance_to" required="parent.apc_distance_interval" column_invisible="parent.apc_distance_interval == False" />
                                    <field name="sender_zip_prefix" required="parent.apc_sender_zip_prefix" column_invisible="parent.apc_sender_zip_prefix == False" />
                                    <field name="sender_country_id" required="parent.apc_sender_country" column_invisible="parent.apc_sender_country == False" />
                                    <field name="receiver_zip_prefix" required="parent.apc_receiver_zip_prefix" column_invisible="parent.apc_receiver_zip_prefix == False" />
                                    <field name="receiver_country_id" required="parent.apc_receiver_country" column_invisible="parent.apc_receiver_country == False" />
                                    <field name="customer_id" required="parent.apc_customer" column_invisible="parent.apc_customer == False" />
                                    <field name="company_id" required="parent.apc_company" column_invisible="parent.apc_company == False" />
                                    <field name="sender_price_zone_id" required="parent.apc_sender_price_zone" column_invisible="parent.apc_sender_price_zone == False" />
                                    <field name="receiver_price_zone_id" required="parent.apc_receiver_price_zone" column_invisible="parent.apc_receiver_price_zone == False" />
                                    <field name="freight_service_id" required="parent.apc_freight_service" column_invisible="parent.apc_freight_service == False" />
                                    <field name="adr" column_invisible="parent.apc_adr == False" />
                                    <field name="bulky_goods" column_invisible="parent.apc_bulky_goods == False" />
                                    <field name="requirement_ids" widget="many2many_tags" column_invisible="parent.apc_requirements == False" options="{'color_field': 'color', 'no_create_edit': True}" />
                                    <field name="planning_type" />
                                </list>
                            </field>
                        </group>
                    </sheet>
                    <chatter>
                        <field name="message_follower_ids" groups="base.group_user" />
                        <field name="message_ids" />
                    </chatter>
                </form>
            </field>
        </record>

        <record id="action_transport_order_type" model="ir.actions.act_window">
            <field name="name">Transport order types</field>
            <field name="res_model">transport.order.type</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create a new transport order type</p>
            </field>
        </record>
    </data>
</odoo>